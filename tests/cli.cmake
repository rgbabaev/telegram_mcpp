foreach(argument --help --version invalid)
    execute_process(COMMAND "${PROGRAM}" "${argument}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "CLI wrote to stdout")
    endif()
    if(argument STREQUAL "invalid")
        if(NOT result EQUAL 2)
            message(FATAL_ERROR "Invalid command did not fail")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "CLI command failed: ${diagnostics}")
    endif()
endforeach()

string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/cli-${suffix}")
set(config "${directory}/config.local")
execute_process(COMMAND "${PROGRAM}" config init "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Configuration initialization failed: ${diagnostics}")
endif()
execute_process(COMMAND "${PROGRAM}" config check "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 1 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Placeholder configuration was accepted")
endif()
file(WRITE "${config}" "api_id=12345\napi_hash=0123456789abcdef0123456789abcdef\nstate_directory=state\nallowed_chat_ids=\n")
execute_process(COMMAND "${PROGRAM}" config check "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0 OR NOT output STREQUAL "" OR NOT IS_DIRECTORY "${directory}/state")
    message(FATAL_ERROR "Valid configuration check failed: ${diagnostics}")
endif()
file(APPEND "${config}" "unexpected=private-search-query\n")
execute_process(COMMAND "${PROGRAM}" config check "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR diagnostics MATCHES "private-search-query|0123456789abcdef")
    message(FATAL_ERROR "Invalid configuration diagnostics leaked values or failed incorrectly")
endif()
file(REMOVE_RECURSE "${directory}")
